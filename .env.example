# QuestDB local defaults
QUESTDB_HOST=localhost
QUESTDB_PG_PORT=8812
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest
QUESTDB_DATABASE=qdb

# Market-data providers
TRADFI_PROVIDER=polygon
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Social sentiment provider: askgrok, lunarcrush, or disabled
SOCIAL_SENTIMENT_PROVIDER=askgrok
ASKGROK_BASE_URL=http://localhost:3000
ASKGROK_TIMEOUT_MS=180000
LUNARCRUSH_API_KEY=
TARDIS_API_KEY=

# Optional live ETL defaults
ASTRO_ABM_CRYPTO_SYMBOLS=BTCUSDT
ASTRO_ABM_TRADFI_SYMBOLS=SPY
ASTRO_ABM_SOCIAL_SYMBOLS=BTC

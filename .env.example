# QuestDB local defaults
NEXT_PUBLIC_ASTRO_ABM_SOURCE_URL=https://github.com/KiVixx/astro-abm

# Account/session storage. Keep the SQLite database outside Git.
ASTRO_ABM_ACCOUNTS_DB_PATH=.local/astro_abm_accounts.sqlite3
ASTRO_ABM_ENV=development
ASTRO_ABM_SESSION_TTL_HOURS=168
ASTRO_ABM_GUEST_TTL_DAYS=30
ASTRO_ABM_GUEST_SCENARIO_QUOTA=20
ASTRO_ABM_USER_SCENARIO_QUOTA=200
ASTRO_ABM_CREATE_RATE_PER_HOUR=60
ASTRO_ABM_LLM_RATE_PER_HOUR=240
ASTRO_ABM_IP_CREATE_RATE_PER_HOUR=12
ASTRO_ABM_IP_CREATE_RATE_PER_DAY=40
ASTRO_ABM_IP_LLM_RATE_PER_HOUR=120
ASTRO_ABM_IP_REGISTER_RATE_PER_HOUR=5
ASTRO_ABM_IP_LOGIN_RATE_PER_15_MINUTES=20
# Only trust X-Forwarded-For when the direct peer is in these IP/CIDR ranges.
ASTRO_ABM_TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
# Set a long random production value; raw client IPs are never stored.
ASTRO_ABM_RATE_LIMIT_SALT=change-me-in-production
ASTRO_ABM_MAX_REQUEST_BODY_BYTES=4194304
ASTRO_ABM_SCENARIO_MAX_REPORT_BYTES=16777216
ASTRO_ABM_SCENARIO_STORE_MAX_REPORTS=5000
ASTRO_ABM_SCENARIO_STORE_MAX_BYTES=2147483648
ASTRO_ABM_GENERATION_GLOBAL_CONCURRENCY=4
ASTRO_ABM_GENERATION_OWNER_CONCURRENCY=1
ASTRO_ABM_GENERATION_LEASE_SECONDS=1800
ASTRO_ABM_SCENARIO_MAX_DAYS=366
ASTRO_ABM_SCENARIO_LIST_SCAN_LIMIT=1000
# Keep disabled in production; presets contain deployment-global configuration.
ASTRO_ABM_ALLOW_REMOTE_PRESET_MANAGEMENT=0
ASTRO_ABM_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

QUESTDB_HOST=localhost
QUESTDB_PG_PORT=8812
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest
QUESTDB_DATABASE=qdb

# Market-data providers
TRADFI_PROVIDER=polygon
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Disabled experimental providers are intentionally omitted from the active setup.
SOCIAL_SENTIMENT_PROVIDER=disabled

# Optional live ETL defaults
ASTRO_ABM_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
ASTRO_ABM_TRADFI_SYMBOLS=SPY
ASTRO_ABM_SOCIAL_SYMBOLS=
ASTRO_ABM_RUN_ON_START=hourly
ASTRO_ABM_DAILY_HOUR=0
ASTRO_ABM_DAILY_MINUTE=20
ASTRO_ABM_EPHEMERIS_FORWARD_DAYS=370

# Product Scenario / Workbench daily snapshot maintenance
ASTRO_ABM_REFRESH_PRODUCT_SNAPSHOTS=1
ASTRO_ABM_PRODUCT_SNAPSHOT_HOUR=1
ASTRO_ABM_PRODUCT_SNAPSHOT_MINUTE=10
ASTRO_ABM_PRODUCT_SNAPSHOT_MODE=local-full
ASTRO_ABM_PRODUCT_SNAPSHOT_INGEST=0

# Optional ignored local long-history CSV refresh.
# Enable both only after reviewing local source/licensing notes.
ASTRO_ABM_REFRESH_LOCAL_DATA=0
ASTRO_ABM_ACCEPT_RESEARCH_LOCAL_TERMS=0

# Optional scenario LLM defaults.
# The web create form can override these per scenario; API keys are not saved.
ASTRO_ABM_ENABLE_REAL_LLM=0
ASTRO_ABM_LLM_BASE_URL=http://localhost:11434/v1
ASTRO_ABM_LLM_MODEL=gemini-3.5-flash-thinking
ASTRO_ABM_LLM_API_KEY=
ASTRO_ABM_LLM_TIMEOUT_SECONDS=120
ASTRO_ABM_LLM_MAX_OUTPUT_TOKENS=32000
ASTRO_ABM_LLM_MAX_CONTEXT_DAYS=60
